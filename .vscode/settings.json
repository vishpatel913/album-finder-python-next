{
  "editor.formatOnSave": true,

  // Python (backend/, scripts/) — ruff handles format + imports.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "python.languageServer": "Pylance",
  "pylint.enabled": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",

  // Tailwind v4: pick up classes inside cn(...) and cva(...) helpers.
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "tailwindCSS.classAttributes": ["class", "className"],

  // Keep generated and build output out of search/explorer noise.
  "files.exclude": {
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "frontend/src/types/api.gen.ts": true
  }
}
