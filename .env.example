# Copy to .env on the host before running `docker compose up`.

# Path on the HOST to your Music.app Library.xml export.
# Defaults to ~/Music/Library.xml if unset.
MUSIC_LIBRARY_XML_HOST_PATH=~/Music/Library.xml

# Spotify API credentials (https://developer.spotify.com/dashboard).
# Same creds power both read-only enrichment (client-credentials) and the
# write actions (follow artist / save album) via user OAuth.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# OAuth redirect URI for the one-time user consent (write access).
# Must EXACTLY match a Redirect URI registered in the Spotify dashboard.
# Use 127.0.0.1, not localhost (Spotify rejects localhost for new URIs).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
